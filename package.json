{
  "name": "mobile-app-template",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint:check": "pnpm exec eslint .",
    "lint:fix": "pnpm exec eslint . --fix",
    "prettier:check": "pnpm exec prettier --check .",
    "prettier:fix": "pnpm exec prettier --write .",
    "tsc": "pnpm exec tsc --noEmit",
    "prepare": "husky",
    "pre-commit": "(pnpm run tsc || true) && (pnpm run lint:check || true) && pnpm run prettier:check",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@rneui/base": "4.0.0-rc.7",
    "@rneui/themed": "4.0.0-rc.8",
    "@supabase/supabase-js": "^2.53.0",
    "expo": "^54.0.33",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.3",
    "react-native-url-polyfill": "^2.0.0",
    "typescript-eslint": "^8.38.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@eslint/js": "^9.32.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@types/react": "~19.1.14",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.32.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.3",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~5.9.2",
    "yarnhook": "^0.6.2"
  },
  "private": true
}
